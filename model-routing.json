{
  "_doc": "AgentOS Model Router — OmO pattern, déclaratif. Modifié sans redémarrer (rechargé à chaque appel).",
  "_version": "1.0.0",

  "providers": {
    "opencode_zen": {
      "base_url": "https://opencode.ai/zen/v1/chat/completions",
      "api_key_env": "OPENCODE_API_KEY",
      "enabled": true,
      "note": "Moteur principal — clé abonnement OpenCode Go"
    },
    "ollama": {
      "base_url": "http://localhost:11434/v1",
      "api_key_env": null,
      "enabled": true
    },
    "openrouter": {
      "base_url": "https://openrouter.ai/api/v1",
      "api_key_env": "OPENROUTER_API_KEY",
      "enabled": false
    }
  },

  "models": {
    "strong": {
      "provider": "opencode_zen",
      "model_id": "claude-sonnet-4-6",
      "category": "deep",
      "fallback": ["standard", "fast"]
    },
    "standard": {
      "provider": "opencode_zen",
      "model_id": "deepseek-v4-flash",
      "category": "utility",
      "fallback": ["fast", "free"]
    },
    "fast": {
      "provider": "opencode_zen",
      "model_id": "deepseek-v4-flash-free",
      "category": "quick",
      "fallback": ["free"]
    },
    "free": {
      "provider": "opencode_zen",
      "model_id": "deepseek-v4-flash-free",
      "category": "quick",
      "fallback": []
    }
  },

  "stages": {
    "planning": "strong",
    "execution": "standard",
    "verification": "fast",
    "utility": "fast",
    "research": "strong",
    "chat": "standard"
  },

  "heuristic": {
    "strong_signals": [
      "implement", "architect", "design system", "refactor", "security",
      "performance", "algorithm", "consensus", "distributed", "migration",
      "implémenter", "architecturer", "concevoir", "refactoriser", "sécurité",
      "performan", "algorithme", "distribué", "migration", "analyse profonde",
      "explique en detail", "compare", "stratégie"
    ],
    "weak_signals": [
      "hello", "bonjour", "hi", "merci", "thanks", "ok", "oui", "non",
      "capital", "what is", "qu'est", "define", "list", "liste", "résume"
    ],
    "word_count_thresholds": {
      "weak_max": 8,
      "strong_min": 40
    },
    "score_thresholds": {
      "strong": 0.6,
      "standard": 0.35
    }
  },

  "runtime_fallback": {
    "retry_on_status": [400, 429, 500, 502, 503, 529],
    "cooldown_seconds": 30,
    "max_attempts": 3,
    "blacklist_on_consecutive_failures": 2
  }
}
