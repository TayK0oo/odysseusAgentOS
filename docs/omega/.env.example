# AgentOS Omega — Credentials template
# Copier ce fichier vers `.env` (NON versionné) et renseigner les valeurs.
#   cp docs/omega/.env.example .env
# Ne JAMAIS committer .env. Variables lues par le routeur et les pipelines de recherche.

# ── Routeur — ZenRouter (moteur principal) ─────────────────────────────────────
OPENCODE_API_KEY=

# ── Recherche / reverse-engineering ────────────────────────────────────────────
GITHUB_TOKEN=
HF_TOKEN=

# ── Scraping profond (optionnel) ───────────────────────────────────────────────
# Cookie de session TikTok (uniquement pour transcription/scraping au-delà des descriptions)
TIKTOK_SESSIONID=

# ── Compute élastique (sandbox / self-hosting) ─────────────────────────────────
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ── Self-hosting local (optionnel) ─────────────────────────────────────────────
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LM_STUDIO_URL=http://localhost:1234/v1

# ── Fournisseurs LLM supplémentaires (optionnel, registre routeur) ─────────────
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# XAI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
